#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

# Seed FIRES env settings on installs that predate them
ynh_app_setting_set_default --key=log_level --value="$default_log_level"
ynh_app_setting_set_default --key=database_pool_min --value="$default_database_pool_min"
ynh_app_setting_set_default --key=database_pool_max --value="$default_database_pool_max"

# Recompute the compiled-output working directory in case it wasn't stored
workdir="$install_dir/$fires_dir/build"
ynh_app_setting_set_default --key=workdir --value="$workdir"

# Make sure an APP_KEY exists (must stay stable to avoid invalidating tokens)
if [ -z "${app_key:-}" ]; then
    app_key=$(ynh_string_random --length=64)
    ynh_app_setting_set --key=app_key --value="$app_key"
fi

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# FIRES keeps all of its state in PostgreSQL, so the source tree can be fully
# replaced; the build/ output and its .env are regenerated below.
ynh_setup_source --dest_dir="$install_dir" --full_replace

chown -R "$app:www-data" "$install_dir"

#=================================================
# BUILD APP
#=================================================
ynh_script_progression "Rebuilding $app (this may take a while)..."

build_fires
chown -R "$app:www-data" "$install_dir"

#=================================================
# UPDATE THE CONFIG FILE
#=================================================
ynh_script_progression "Updating $app's configuration..."

public_url="https://${domain}${path%/}/"

# The bootstrap admin password ($password) is only available at install time and
# is not needed on upgrade: FIRES only creates the initial admin when no users
# exist yet, which is never the case here. Leave it empty (the field is optional).
# $admin_email, $default_locale, $app_key, $log_level and the pool sizes are all
# loaded automatically from the app settings.
admin_password=""

ynh_config_add --template=".env" --destination="$workdir/.env"
chmod 600 "$workdir/.env"
chown "$app:$app" "$workdir/.env"

#=================================================
# RUN DATABASE MIGRATIONS
#=================================================
ynh_script_progression "Running database migrations..."

migrate_fires

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="FediMod FIRES server" --log="/var/log/$app/$app.log"

ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --wait_until="started HTTP server" --log_path="/var/log/$app/$app.log"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
