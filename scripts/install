#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

### Install parameters are automatically saved as settings: $domain, $path,
### $language, $admin, $admin_email, plus resource settings such as
### $install_dir, $data_dir, $port, $db_name, $db_user, $db_pwd, $nodejs_dir.
### Note: $password (the FIRES admin password question) is NOT saved as a setting.

#=================================================
# VALIDATE INPUT
#=================================================

# FIRES only bootstraps the initial admin when the password is longer than 16
# characters (see start/migrations.ts upstream); the "password" question type
# doesn't support a "pattern" property, so enforce this here instead.
if [ "${#password}" -le 16 ]; then
    ynh_die "The FIRES admin password must be longer than 16 characters."
fi

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================
ynh_script_progression "Storing installation settings..."

# Compiled AdonisJS output (used as the systemd working directory)
workdir="$install_dir/$fires_dir/build"
ynh_app_setting_set --key=workdir --value="$workdir"

# Generate the APP_KEY used by FIRES for encryption/signing/hashing
app_key=$(ynh_string_random --length=64)
ynh_app_setting_set --key=app_key --value="$app_key"

# FIRES environment variables exposed as settings / config-panel tunables
ynh_app_setting_set --key=log_level --value="$default_log_level"
ynh_app_setting_set --key=database_pool_min --value="$default_database_pool_min"
ynh_app_setting_set --key=database_pool_max --value="$default_database_pool_max"

# DEFAULT_LOCALE must be a full BCP-47 tag present in config/locales; map the
# install language choice to a supported locale.
case "$language" in
    fr) default_locale="fr-FR" ;;
    *)  default_locale="en-US" ;;
esac
ynh_app_setting_set --key=default_locale --value="$default_locale"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

# Download, check integrity, uncompress and patch the source from manifest.toml
ynh_setup_source --dest_dir="$install_dir"

chown -R "$app:www-data" "$install_dir"

#=================================================
# BUILD APP
#=================================================
ynh_script_progression "Building $app (this may take a while)..."

# Build first: the build step (re)creates the build/ output directory.
build_fires
chown -R "$app:www-data" "$install_dir"

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration..."

# Public URL of this FIRES server as seen on the internet
public_url="https://${domain}${path%/}/"

# Generate the .env consumed by the AdonisJS server, next to the compiled
# bin/server.js. All __VAR__ placeholders below are filled from the matching
# shell variables:
#   __PORT__, __PUBLIC_URL__, __DEFAULT_LOCALE__, __APP_KEY__,
#   __DB_USER__, __DB_PWD__, __DB_NAME__, __LOG_LEVEL__,
#   __DATABASE_POOL_MIN__, __DATABASE_POOL_MAX__,
#   __ADMIN_EMAIL__, __ADMIN_PASSWORD__
admin_password="$password"
ynh_config_add --template=".env" --destination="$workdir/.env"

chmod 600 "$workdir/.env"
chown "$app:$app" "$workdir/.env"

#=================================================
# RUN DATABASE MIGRATIONS
#=================================================
ynh_script_progression "Running database migrations..."

migrate_fires

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

# Create a dedicated NGINX config using the conf/nginx.conf template
ynh_config_add_nginx

# Create a dedicated systemd config
ynh_config_add_systemd

yunohost service add "$app" --description="FediMod FIRES server" --log="/var/log/$app/$app.log"

# Use logrotate to manage application logfile(s)
ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

# On first boot FIRES creates the admin account from FIRES_ADMIN_USERNAME /
# FIRES_ADMIN_PASSWORD set in the .env above.
ynh_systemctl --service="$app" --action="start" --wait_until="started HTTP server" --log_path="/var/log/$app/$app.log"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
