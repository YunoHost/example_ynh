# FediMod FIRES — environment configuration
#
# Generated by the YunoHost installer. Managed values are filled in from the
# install questions and provisioned resources. Reference:
# https://fires.fedimod.org/manuals/reference-server/environment.html

# --- Runtime ---------------------------------------------------------------
TZ=UTC
NODE_ENV=production
# Logging verbosity: fatal, error, warn, info, debug, trace
LOG_LEVEL=__LOG_LEVEL__

# --- HTTP server -----------------------------------------------------------
# Bound to localhost only; public traffic is reverse-proxied by NGINX.
HOST=127.0.0.1
PORT=__PORT__
# The public URL of this FIRES server as seen on the internet.
PUBLIC_URL=__PUBLIC_URL__
# Default locale. Must be one of the BCP-47 tags listed in config/locales
# (e.g. en-US, fr-FR); defaults upstream to en-US.
DEFAULT_LOCALE=__DEFAULT_LOCALE__

# --- Security --------------------------------------------------------------
# Key used for encryption, signing and hashing. Changing this value will
# invalidate all existing access tokens.
APP_KEY=__APP_KEY__

# --- Database (PostgreSQL 17+) ---------------------------------------------
DATABASE_URL=postgresql://__DB_USER__:__DB_PWD__@127.0.0.1:5432/__DB_NAME__
# Connection pool bounds.
DATABASE_POOL_MIN=__DATABASE_POOL_MIN__
DATABASE_POOL_MAX=__DATABASE_POOL_MAX__
# YunoHost runs pending migrations during install/upgrade, so the server does
# not need to migrate on boot.
DATABASE_AUTOMIGRATE=false

# --- Bootstrap administrator ----------------------------------------------
# On first boot, if no administrators exist yet, an admin account is created
# from these credentials.
FIRES_ADMIN_USERNAME=__ADMIN_EMAIL__
FIRES_ADMIN_PASSWORD=__ADMIN_PASSWORD__
